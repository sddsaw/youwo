# 应用的基础路径，默认为 "/"
# 如果使用子目录，必须以 "/" 结尾，例如 "/admin/" 而不是 "/admin"
VITE_BASE_URL=/

VITE_APP_TITLE=ChipTest ATE 知识库

VITE_APP_DESC=ChipTest ATE 知识库

# 图标名称的前缀
VITE_ICON_PREFIX=icon

# 本地 SVG 图标组件的前缀，必须包含 VITE_ICON_PREFIX
# 格式为 {VITE_ICON_PREFIX}-{本地图标名称}
VITE_ICON_LOCAL_PREFIX=icon-local

# 路由权限模式：static (静态) ｜ dynamic (动态)
VITE_AUTH_ROUTE_MODE=static

# 静态路由模式下的主页路由键
VITE_ROUTE_HOME=home

# 默认的菜单图标
VITE_MENU_ICON=mdi:menu

# 是否在开发模式下启用 HTTP 代理
VITE_HTTP_PROXY=Y

# 路由历史模式：hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# 后端服务的成功状态码，当接收到该代码时，说明请求成功
VITE_SERVICE_SUCCESS_CODE=0000

# 后端服务的直接登出状态码，当接收到该代码时，用户将被登出并重定向到登录页面
VITE_SERVICE_LOGOUT_CODES=8888,8889

# 后端服务的弹窗登出状态码，当接收到该代码时，将弹窗提示并登出用户
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778

# 后端服务的 Token 过期状态码，当接收到该代码时，将尝试自动刷新 Token 并重新发送请求
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# 当路由模式为静态路由时，定义的超级管理员角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# 是否生成 sourcemap
VITE_SOURCE_MAP=N

# 用于在不同域名间区分本地存储 (LocalStorage 等) 的前缀
VITE_STORAGE_PREFIX=SOY_

# 用于控制程序是否自动检测更新
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# 是否在终端显示代理请求的日志
VITE_PROXY_LOG=Y

# 用于控制是否能通过 Vue Devtools 启动本地 IDE 编辑器
# 注：此插件仅在开发模式下有效，构建打包时不会引入
VITE_DEVTOOLS_LAUNCH_EDITOR=code

# 是否开启构建体积可视化分析 (rollup-plugin-visualizer)
VITE_VISUALIZER=Y
